{
  "version": 2,
  "builds": [
    {
      "src": "src/pages/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "src/**/*.{js,css,png,jpg,jpeg,gif,svg,ico}",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*.{png,jpg,jpeg,gif,svg,ico}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/src/pages/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/src/pages/$1"
    }
  ]
}
